# ──────────────────────────────────────────────────────────────
#  Configurações do assistente. Edite este arquivo e rode:
#    docker compose up -d agent-api      (ou ./start.ps1)
# ──────────────────────────────────────────────────────────────

# ── Modelo (Ollama, 100% local). Deixe SÓ UMA linha OLLAMA_MODEL sem "#". ──
# Modelos já baixados nesta máquina:
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_MODEL=gemma2:2b            # leve, mais rápido, menos preciso
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_MODEL=qwen3-vl:8b          # maior e mais lento
# OLLAMA_MODEL=dolphin-llama3:latest
# Sugestões (o start.ps1 baixa sozinho na primeira vez):
# OLLAMA_MODEL=qwen2.5:7b           # melhor para evitar erros de leitura dos dados
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MODEL=qwen2.5:1.5b         # muito rápido, só para testar fluxo

# Criatividade: 0 = mais literal (recomendado), 1 = mais solto.
OLLAMA_TEMPERATURE=0.2

# ── Saudação automática ──
# on  = "oi"/"obrigado" recebem uma resposta pronta, sem usar o modelo.
# off = cumprimentos também passam pelo modelo.
AUTO_GREETING=on
# AUTO_GREETING=off
