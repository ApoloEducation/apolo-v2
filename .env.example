# Safe, local-only defaults. Do not reuse in any shared environment.
CHATWOOT_SECRET_KEY_BASE=change-this-to-a-long-random-local-secret
CHATWOOT_POSTGRES_PASSWORD=chatwoot-local-password
CHATWOOT_ADMIN_EMAIL=admin@escola.local
CHATWOOT_ADMIN_PASSWORD=ApoloLocal2026!
CHATWOOT_HUMAN_EMAIL=atendente@escola.local
CHATWOOT_HUMAN_PASSWORD=ApoloLocal2026!


# ── WhatsApp Cloud API (opcional; veja docs/WHATSAPP.md). Deixe vazio para usar só o Mini-WhatsApp. ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=apolo-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# telefone (com DDI+DDD, só dígitos) = id do responsável no demo (g01..g12), separados por vírgula
WHATSAPP_GUARDIAN_PHONES=
