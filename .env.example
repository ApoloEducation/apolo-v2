# Safe, local-only defaults. Do not reuse in any shared environment.
CHATWOOT_SECRET_KEY_BASE=change-this-to-a-long-random-local-secret
CHATWOOT_POSTGRES_PASSWORD=chatwoot-local-password
CHATWOOT_ADMIN_EMAIL=admin@escola.local
CHATWOOT_ADMIN_PASSWORD=ApoloLocal2026!
CHATWOOT_HUMAN_EMAIL=atendente@escola.local
CHATWOOT_HUMAN_PASSWORD=ApoloLocal2026!
OLLAMA_MODEL=qwen2.5:14b
# Used by `make start LLM=openrouter` instead of Ollama.
OPENROUTER_MODEL=
OPEN_ROUTER_API_KEY=

# School panel at http://localhost:8001/admin. Disabled when empty.
ADMIN_TOKEN=
# Browser origins allowed to call the Agent API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WhatsApp Cloud API (Meta). META_API_TOKEN is the access token.
META_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# Optional: Meta app secret, enables X-Hub-Signature-256 validation.
WHATSAPP_APP_SECRET=
# Allow-list, comma-separated wa_id:school:guardian, e.g. 5511999999999:horizonte:g01. Other senders are ignored.
WHATSAPP_ALLOWED_NUMBERS=
